#!/usr/bin/env bash
# verum install — bootstrap an operator-owned identity on this device.
#
# Usage:
#   curl -fsSL https://verum.sh/install | bash
#
# What this does:
#   1. Detects your OS (macOS or Linux)
#   2. Verifies openssl is available; installs via brew/apt if missing
#   3. Generates an Ed25519 identity at ~/.verum/operator-ed25519.key
#      (chmod 600). Refuses to overwrite an existing identity.
#   4. Prints your public key for registration at verum.sh/u/<handle>
#   5. Optionally: deploys the mae Obsidian plugin to a vault you specify
#
# Source: https://github.com/ramene/verum.sh/blob/main/public/install

set -euo pipefail

VERUM_DIR="${HOME}/.verum"
KEY_PATH="${VERUM_DIR}/operator-ed25519.key"
MAE_TARBALL_URL="https://verum.sh/mae-plugin.tar.gz"

bold() { printf '\033[1m%s\033[0m\n' "$1"; }
muted() { printf '\033[2m%s\033[0m\n' "$1"; }
warn() { printf '\033[33m%s\033[0m\n' "$1" >&2; }
fail() { printf '\033[31m%s\033[0m\n' "$1" >&2; exit 1; }

echo
bold "verum install · v0.1"
muted "operator-owned keys, biometric-gated, audit-chained"
echo

# 1. OS detection
OS="$(uname -s)"
case "$OS" in
  Darwin) OS_NAME="macOS" ;;
  Linux)  OS_NAME="Linux" ;;
  *) fail "Unsupported OS: $OS (verum supports macOS and Linux today)" ;;
esac
bold "  Detected: ${OS_NAME}"

# 2. openssl preflight
if ! command -v openssl >/dev/null 2>&1; then
  warn "  openssl not found"
  case "$OS_NAME" in
    macOS)
      if command -v brew >/dev/null 2>&1; then
        bold "  Installing openssl via Homebrew..."
        brew install openssl@3
      else
        fail "Install Homebrew first (https://brew.sh) then re-run this script."
      fi
      ;;
    Linux)
      bold "  Installing openssl via apt..."
      sudo apt-get update && sudo apt-get install -y openssl
      ;;
  esac
fi
bold "  ✓ openssl available"

# 3. Identity generation (refuse to overwrite)
if [ -f "$KEY_PATH" ]; then
  warn "  Identity already exists at $KEY_PATH"
  warn "  Refusing to overwrite. To start over, back up + remove that file."
else
  mkdir -p "$VERUM_DIR"
  chmod 700 "$VERUM_DIR"
  openssl genpkey -algorithm ed25519 -out "$KEY_PATH" 2>/dev/null
  chmod 600 "$KEY_PATH"
  bold "  ✓ Generated Ed25519 identity at $KEY_PATH"
fi

# 4. Print public key for verum.sh registration
PUBKEY_B64="$(openssl pkey -in "$KEY_PATH" -pubout -outform DER 2>/dev/null | tail -c 32 | base64)"
echo
bold "Your verum identity (Ed25519 public key, raw 32B base64):"
echo
echo "  ${PUBKEY_B64}"
echo
muted "Register this at https://verum.sh/u/<your-handle> to receive signed shares."

# 5. mae plugin (optional)
echo
# Detect non-interactive (piped) execution — skip prompts in that case.
if [ -t 0 ]; then
  read -p "Install mae Obsidian plugin too? [Y/n] " -n 1 -r reply
  echo
else
  reply="n"
  muted "(non-interactive — skipping mae plugin install. Re-run with bash -i for prompts.)"
fi

if [[ ! $reply =~ ^[Nn]$ ]]; then
  if [ -t 0 ]; then
    read -p "Path to your Obsidian vault: " VAULT_PATH
  else
    VAULT_PATH=""
  fi
  if [ -z "$VAULT_PATH" ] || [ ! -d "$VAULT_PATH/.obsidian" ]; then
    warn "  Skipped — vault path is empty or missing .obsidian/"
    warn "  Re-run this script later, or manually unpack:"
    warn "    curl -fsSL ${MAE_TARBALL_URL} | tar -xz -C <vault>/.obsidian/plugins/mae/"
  else
    PLUGIN_DIR="${VAULT_PATH}/.obsidian/plugins/mae"
    mkdir -p "$PLUGIN_DIR"
    bold "  Downloading mae plugin..."
    if curl -fsSL "${MAE_TARBALL_URL}" | tar -xz -C "$PLUGIN_DIR"; then
      [ -f "${PLUGIN_DIR}/mae-touchid-helper" ] && chmod +x "${PLUGIN_DIR}/mae-touchid-helper"
      bold "  ✓ Deployed to ${PLUGIN_DIR}"
      muted "    Open Obsidian → Settings → Community plugins → enable 'mae'"
    else
      warn "  Tarball download failed. Skipping mae install."
    fi
  fi
fi

# 6. Wrap-up
echo
bold "Done."
muted "Your private key lives at ${KEY_PATH} (chmod 600). Back it up to a place"
muted "you control. Anyone who has it controls your identity."
echo
muted "Next: open your Obsidian vault, run \"mae: Export recipient profile\","
muted "and send the JSON to whoever wants to share signed material with you."
echo
